.km-blackberry{font:1em Slate,Helvetica,sans-serif}
.km-blackberry .km-button,.km-blackberry .km-buttongroup,.km-blackberry .km-navbar,.km-blackberry .km-tabstrip,.km-blackberry .km-toolbar,.km-blackberry input[type=file]{font-weight:400;border:0;border-radius:3px}
.km-blackberry .km-navbar,.km-blackberry .km-tabstrip,.km-blackberry .km-toolbar{border-radius:0}
.km-blackberry .km-tabstrip .km-icon{width:2.4rem;height:2.4rem;font-size:2.4rem;position:relative;margin:.3rem auto}
.km-blackberry.km-vertical .km-tabstrip .km-icon{margin:.2rem auto .1rem}
